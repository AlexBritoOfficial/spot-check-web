# These are the Supabase CLI's fixed local demo values — identical on
# every machine running `supabase start`, so safe to commit. The schema
# itself lives in spot-check-iOS/supabase/ (soon spot-check-backend); run
# `supabase start` from there, this app never vendors its own supabase/
# folder. ANON_KEY's name is legacy; the value below is the newer
# publishable key `supabase status` prints — same public-key role, same
# RLS enforcement, just the current key format.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# Running `npm test` locally needs the same local Supabase stack running —
# see .env.test.example, copy it to .env.test.

# Required by src/app/api/upload/route.ts to store spot photos in Vercel
# Blob. Don't set this by hand — create/connect the Blob store (see the
# setup wizard) then run `vercel env pull .env.local` to get the real value.
BLOB_READ_WRITE_TOKEN=
