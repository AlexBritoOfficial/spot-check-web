# Same local demo values as .env.example — the integration test
# (src/app/api/spots/route.test.ts) runs real PostGIS/RLS queries against
# the same local stack `npm run dev` uses, not a separate database.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# Test-only: lets fixture setup/teardown bypass RLS, the way
# prisma/seed.ts used to via a direct connection. Never prefixed
# NEXT_PUBLIC_ — this must never reach the browser. Even against the
# local stack this still looks like a real secret to GitHub's push
# protection, so it's never a literal value here — copy the SECRET_KEY
# `supabase status` prints after `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=
